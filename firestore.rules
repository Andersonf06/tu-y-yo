rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hogar(hid) { return get(/databases/$(database)/documents/hogares/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in hogar(hid).members; }
    function colOk(col) { return col in ['gastos', 'deudas', 'metas', 'aportes', 'ingresos', 'fijos', 'cuentas', 'citas']; }

    match /hogares/{hid} {
      // Solo los dos miembros leen el hogar (incluye el token de invitación).
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      // Crear: uno mismo como único miembro, con token de 36 caracteres.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.joinToken is string
        && request.resource.data.joinToken.size() == 36;

      allow update: if
        // 1. Cualquiera de los dos cambia la configuración (mismo control para ambos), sin tocar miembros ni token.
        (signedIn() && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.joinToken == resource.data.joinToken)
        // 2. Unirse: quien conoce el token se agrega a sí mismo; máximo 2 personas.
        || (signedIn()
          && resource.data.members.size() < 2
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.joinProof == resource.data.joinToken
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinProof']))
        // 3. "Mi pareja cambió de celular": un miembro queda solo y genera un token nuevo para re-invitar.
        || (signedIn() && request.auth.uid in resource.data.members
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.joinToken is string
          && request.resource.data.joinToken.size() == 36
          && request.resource.data.joinToken != resource.data.joinToken
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinToken']));

      allow delete: if false;

      // Datos del hogar: solo los miembros, solo colecciones conocidas, documentos pequeños.
      match /{col}/{docId} {
        allow read, delete: if colOk(col) && isMember(hid);
        allow create, update: if colOk(col)
          && isMember(hid)
          && request.resource.data.keys().size() <= 30
          && (!('monto' in request.resource.data) || (request.resource.data.monto is number && request.resource.data.monto >= 0 && request.resource.data.monto < 10000000000))
          && (!('por' in request.resource.data) || request.resource.data.por in ['a', 'b']);
      }
    }

    // Códigos cortos de vinculación (6 caracteres, vencen en 48 h).
    match /invitaciones/{code} {
      // Se lee solo pidiendo el código exacto (no se pueden listar) y solo si no ha vencido.
      allow get: if signedIn() && resource.data.expira > request.time;
      allow list: if false;
      // Solo un miembro del hogar crea el código, con el token real del hogar.
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['hid', 'token', 'creador', 'expira'])
        && request.resource.data.creador == request.auth.uid
        && request.auth.uid in hogar(request.resource.data.hid).members
        && request.resource.data.token == hogar(request.resource.data.hid).joinToken
        && request.resource.data.expira is timestamp
        && request.resource.data.expira < request.time + duration.value(49, 'h');
      allow update: if false;
      // Lo borra quien lo creó o quien ya entró al hogar.
      allow delete: if signedIn() && (resource.data.creador == request.auth.uid || request.auth.uid in hogar(resource.data.hid).members);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
